# cp .env.example .env  — then fill in real values. Never commit .env.
# Generate credentials with e.g.: openssl rand -hex 24
REPORT_HOST=dmarc.example.com
DB_PASSWORD=
API_TOKEN=                     # bearer token for /api/*; empty = open
INGEST_TOKEN=                  # only needed if remote SMTP edges forward here
IMAGE=ghcr.io/pescheckit/dmarc-service:latest
