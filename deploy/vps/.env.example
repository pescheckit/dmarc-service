# cp .env.example .env  - then fill in real values. Never commit .env.
# Generate credentials with e.g.: openssl rand -hex 24
REPORT_HOST=dmarc.example.com
DB_PASSWORD=
API_TOKEN=                     # optional static token for automation; users mint their own in the UI
INGEST_TOKEN=                  # only needed if remote SMTP edges forward here
SESSION_SECRET=                # cookie-signing key; keeps UI sessions across restarts
IMAGE=ghcr.io/pescheckit/dmarc-service:latest

# Optional: poll a mailbox instead of receiving on port 25
# (docker compose --profile imap up -d)
# IMAP_HOST=imap.gmail.com
# IMAP_USERNAME=dmarc@example.com
# IMAP_PASSWORD=app-password
# IMAP_PROCESSED_FOLDER=Processed

# Nightly backups (optional). One URL carries endpoint, credentials, bucket
# and an optional prefix; percent-encode keys containing / or +
# BACKUP_S3_URL=s3://ACCESS:SECRET@s3.eu-central-1.wasabisys.com/dmarc-backups/prod
# BACKUP_RETENTION_DAYS=30

# Prometheus metrics (optional), served on 127.0.0.1:9100 and nowhere else.
# The labels name your tenants and domains and show which of them have no
# working DMARC record, so a token is required; set METRICS_LABELS=false to
# publish totals only.
# METRICS_ENABLED=true
# METRICS_TOKEN=                 # openssl rand -hex 24
# METRICS_LABELS=true
